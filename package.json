{
  "name": "@orbinum/protocol",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Orbinum \u2014 chain access, encoding, note types and payment slips. Custody-free.",
  "author": "Orbinum",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run typecheck:all && npm run lint && npm run format:check && npm run build && npm run test",
    "clean": "rm -rf dist node_modules package-lock.json yarn.lock pnpm-lock.yaml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbinum/ts-protocol.git"
  },
  "keywords": [
    "orbinum",
    "sdk",
    "typescript",
    "privacy",
    "blockchain"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/orbinum/ts-protocol/issues"
  },
  "homepage": "https://github.com/orbinum/ts-protocol#readme",
  "devDependencies": {
    "@polkadot/util-crypto": "14.0.3",
    "@types/node": "26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "polkadot-api": "3.1.0",
    "ts-node": "10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "unrun": "^0.3.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "2.4.0",
    "@polkadot-api/metadata-builders": "0.15.1",
    "@polkadot-api/substrate-bindings": "0.21.1",
    "@polkadot-api/tx-utils": "0.6.1",
    "@scure/base": "2.4.0",
    "@zk-kit/baby-jubjub": "1.0.3",
    "poseidon-lite": "0.3.0"
  },
  "peerDependencies": {
    "@polkadot/util-crypto": "^14.0.0",
    "polkadot-api": "^3.1.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
